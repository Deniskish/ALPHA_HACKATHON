PORT=3002
APP_ORIGIN=http://localhost:3000
OPORA_API_URL=http://localhost:3002
# GigaChat Authorization Key (Base64 Client ID:Client Secret), server only.
GIGACHAT_AUTH_KEY=
# Select the scope assigned to your account: PERS, B2B or CORP.
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
AI_SOURCE_SYNC=on
# Live official funding catalogue updates.
FUNDING_SYNC=on
# Host path; Docker Compose uses /data/sources/funding in the opora-sources volume.
OPORA_FUNDING_DIR=
# Optional persistent directory for downloaded public source pages.
OPORA_SOURCE_DIR=./source-data
# If needed, set NODE_EXTRA_CA_CERTS to your trusted PEM bundle BEFORE starting Node.
# Never disable TLS verification.

# Optional trusted PEM bundle. Leave empty when system trust is sufficient.
NODE_EXTRA_CA_CERTS=
# Directory containing fns.sqlite; default is repository fns-data/.
FNS_DATA_DIR=
DADATA_API_KEY=
