# Every variable is optional: the demo flow runs with an empty .env.
PORT=3002
# Comma-separated origins allowed by API CORS.
APP_ORIGIN=http://localhost:3000
# SQLite file with the canonical application state (default: miniapp/api-server/data/credit.sqlite).
CREDIT_DB_PATH=
# Requests per client and minute.
API_RATE_LIMIT=300
# Optional registry lookup for arbitrary INNs. Without it, unknown companies are entered manually.
DADATA_API_KEY=
# Directory containing an imported fns.sqlite index (npm run sync:fns); default is repository fns-data/.
FNS_DATA_DIR=
