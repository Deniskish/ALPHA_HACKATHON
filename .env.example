# Every variable is optional: the demo flow runs with an empty .env.
PORT=3002
# Comma-separated origins allowed by API CORS.
APP_ORIGIN=http://localhost:3000
# SQLite file with the canonical application state (default: miniapp/api-server/data/credit.sqlite).
CREDIT_DB_PATH=
# Requests per client and minute.
API_RATE_LIMIT=300
# Optional registry lookup for arbitrary INNs. Without it, unknown companies are entered manually.
DADATA_API_KEY=
# Directory containing an imported fns.sqlite index (npm run sync:fns); default is repository fns-data/.
FNS_DATA_DIR=
# Trusted reverse proxies for X-Forwarded-For (proxy-addr syntax). Default "loopback"; Docker Compose uses "loopback,uniquelocal".
TRUST_PROXY=
# JSON request logs (method, path without INN, status, duration, request id). Default: on in production.
LOG_REQUESTS=
# Demo key rate, % (the synthetic product rate = key rate + product margin + risk premium).
CREDIT_KEY_RATE=16
# Demo ML risk model (ml/, synthetic data). false = decisions use scoring and rules only.
RISK_MODEL_ENABLED=true
# Optional LLM assistant: explanations and free-text need parsing. Never decides; the flow works with AI_ENABLED=false.
AI_ENABLED=false
# OpenAI-compatible endpoint of a local open-weight model (Ollama by default).
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
# Only for an authenticated endpoint; never commit a real key.
LLM_API_KEY=
LLM_TIMEOUT_MS=20000
